WINDMILL_BASE_URL=https://your-windmill.example.com
WINDMILL_WORKSPACE=beforest-automations
WINDMILL_TOKEN=replace-with-a-search-scoped-token
WINDMILL_TIMEOUT_MS=30000
PORT=3100
HOST=127.0.0.1
# For a private Coolify container: HOST=0.0.0.0 and exact expected hostnames below.
# Host checks are not authentication; see MCP_AUTH_TOKENS.
MCP_ALLOWED_HOSTS=
# One token per person: name:level:token, comma-separated. Levels: oceo, leader, employee.
# Clients send "Authorization: Bearer <token>". Generate each token with: openssl rand -hex 32.
# MCP_USERS or MCP_AUTH_TOKENS is required when HOST=0.0.0.0.
MCP_USERS=
# Legacy shared secret(s): full access, no name in the logs. Remove once everyone has their own token.
MCP_AUTH_TOKENS=
